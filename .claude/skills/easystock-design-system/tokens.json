{
  "$description": "이지스톡 디자인 토큰. 모든 색상은 oklch 변환 가능한 hex로 표기.",

  "color": {
    "light": {
      "bg":           { "value": "#f5f7fb", "desc": "전체 배경. 밝고 깨끗한 블루-화이트 톤." },
      "card":         { "value": "#ffffff", "desc": "카드/패널 배경. 순수 흰색." },
      "card-hover":   { "value": "#f8fbff", "desc": "카드 호버 / 선택된 행." },
      "ink-1":        { "value": "#191f28", "desc": "본문. 메트릭 숫자. 페이지 타이틀." },
      "ink-2":        { "value": "#4e5968", "desc": "보조 본문. 보디 텍스트." },
      "ink-3":        { "value": "#8b95a1", "desc": "캡션. 메타데이터. 라벨." },
      "ink-4":        { "value": "#b0b8c1", "desc": "비활성. 플레이스홀더." },
      "border":       { "value": "#e5e8eb", "desc": "기본 보더. 카드 분리선." },
      "border-strong":{ "value": "#d1d6db", "desc": "보조 보더 / 점선 보더." }
    },
    "dark": {
      "bg":           "#111318",
      "card":         "#1a1f29",
      "card-hover":   "#232936",
      "ink-1":        "#f8fafc",
      "ink-2":        "#d5dbea",
      "ink-3":        "#98a2b3",
      "ink-4":        "#667085",
      "border":       "#2b3240",
      "border-strong":"#3a4252"
    },
    "status": {
      "$desc": "상태색. 발주/주의/안전/정보 의미가 고정되어 있음. 임의 사용 금지.",
      "red": {
        "main":  "#f04452",
        "deep":  "#b42318",
        "soft":  "#fef0f1",
        "soft-dark": "#3d1c20",
        "use":   "발주 필요. 마진 하락 경고. 입력 누락. 단가 인상."
      },
      "amber": {
        "main":  "#ffb020",
        "deep":  "#b54708",
        "soft":  "#fff4db",
        "soft-dark": "#3b2912",
        "use":   "주의. 매입 기록. 유통기한 임박."
      },
      "green": {
        "main":  "#16b364",
        "deep":  "#067647",
        "soft":  "#e8fff3",
        "soft-dark": "#133225",
        "use":   "안전. 순수익 증가. 마진 상승."
      },
      "blue": {
        "main":  "#3182f6",
        "deep":  "#1b64da",
        "soft":  "#eaf3ff",
        "soft-dark": "#16263e",
        "use":   "정보. 토요일/주말 강조. 액션 안내."
      }
    }
  },

  "typography": {
    "$family": "Pretendard, ui-sans-serif, system-ui, sans-serif",
    "$rule": "모든 숫자는 font-variant-numeric: tabular-nums; 강제. 한글은 letter-spacing -0.01em 권장.",
    "scale": {
      "metric-hero":  { "size": "32px", "weight": 700, "tracking": "-0.03em", "use": "어제 매출 / 합계 등 가장 큰 숫자" },
      "metric-lg":    { "size": "26px", "weight": 700, "tracking": "-0.025em", "use": "통계 카드 메인 숫자" },
      "metric-md":    { "size": "17px", "weight": 700, "use": "월 누적 / 상세 메트릭" },
      "title-lg":     { "size": "24px", "weight": 700, "tracking": "-0.02em", "use": "페이지 타이틀" },
      "title-md":     { "size": "19px", "weight": 700, "tracking": "-0.015em", "use": "섹션 타이틀" },
      "body":         { "size": "13.5px", "weight": 600, "use": "본문 강조 / 메뉴명" },
      "body-regular": { "size": "13px",   "weight": 500, "use": "일반 본문" },
      "label":        { "size": "12px",   "weight": 600, "use": "섹션 라벨 / 폼 라벨" },
      "caption":      { "size": "11.5px", "weight": 500, "use": "메타 / 보조 설명" },
      "micro":        { "size": "10.5px", "weight": 600, "use": "배지 / 단위 / 도트 라벨" }
    }
  },

  "spacing": {
    "$rule": "4px 기준. 10/14/16/20/24/28 권장.",
    "tile-padding":   "16px",
    "card-padding":   "16px",
    "screen-padding": "20px",
    "section-gap":    "24px",
    "stack-tight":    "10px",
    "stack":          "14px",
    "stack-loose":    "24px"
  },

  "radius": {
    "$rule": "둥근 모서리 일관성. 인풋 < 카드 < 큰 카드 순.",
    "sm":   "8px",
    "md":   "12px",
    "lg":   "16px",
    "xl":   "20px",
    "full": "9999px"
  },

  "stroke": {
    "$rule": "얕은 그림자 + 얇은 보더를 함께 사용.",
    "hairline": "1px solid var(--border)",
    "strong":   "1px solid var(--border-strong)",
    "dashed":   "1px dashed var(--border-strong)"
  },

  "shadow": {
    "soft": "0 8px 24px rgba(15, 23, 42, 0.06)",
    "card": "0 10px 30px rgba(15, 23, 42, 0.07)",
    "lift": "0 16px 40px rgba(49, 130, 246, 0.12)"
  },

  "interaction": {
    "tap-min": "44px",
    "transition": "all 150ms ease-out",
    "$desc": "모바일 hit target 최소 44px. 키보드 등장 시 입력 필드가 가려지지 않도록 sticky 합계 카드는 bottom: env(safe-area-inset-bottom) 사용."
  }
}
