{
  "$description": "이지스톡 디자인 토큰. 모든 색상은 oklch 변환 가능한 hex로 표기.",

  "color": {
    "light": {
      "bg":           { "value": "#f7f6f2", "desc": "전체 배경. 부드러운 오프화이트. 눈 피로 감소." },
      "card":         { "value": "#ffffff", "desc": "카드/패널 배경. 순수 흰색." },
      "card-hover":   { "value": "#f1efe9", "desc": "카드 호버 / 선택된 행." },
      "ink-1":        { "value": "#1a1a1a", "desc": "본문. 메트릭 숫자. 페이지 타이틀." },
      "ink-2":        { "value": "#43423f", "desc": "보조 본문. 보디 텍스트." },
      "ink-3":        { "value": "#87857f", "desc": "캡션. 메타데이터. 라벨." },
      "ink-4":        { "value": "#c4c1b8", "desc": "비활성. 플레이스홀더." },
      "border":       { "value": "#e8e5db", "desc": "기본 보더. 카드 분리선." },
      "border-strong":{ "value": "#b8b4a8", "desc": "점선 보더 (+ 추가 버튼 등)." }
    },
    "dark": {
      "bg":           "#161513",
      "card":         "#1f1d1a",
      "card-hover":   "#2a2724",
      "ink-1":        "#f0ede5",
      "ink-2":        "#c8c4b8",
      "ink-3":        "#8a8780",
      "ink-4":        "#5a5752",
      "border":       "#2e2c28",
      "border-strong":"#4a4742"
    },
    "status": {
      "$desc": "상태색. 발주/주의/안전/정보 의미가 고정되어 있음. 임의 사용 금지.",
      "red": {
        "main":  "#d6493a",
        "deep":  "#8a2c1f",
        "soft":  "#fbe6e1",
        "soft-dark": "#3a1a14",
        "use":   "발주 필요. 마진 하락 경고. 입력 누락. 단가 인상."
      },
      "amber": {
        "main":  "#b07d1a",
        "deep":  "#6e4a08",
        "soft":  "#fbf0d4",
        "soft-dark": "#3a2a10",
        "use":   "주의. 매입 기록. 유통기한 임박."
      },
      "green": {
        "main":  "#4a8a52",
        "deep":  "#2c5a35",
        "soft":  "#e1f0e2",
        "soft-dark": "#1a2a1d",
        "use":   "안전. 순수익 증가. 마진 상승."
      },
      "blue": {
        "main":  "#3e7bb4",
        "deep":  "#234a72",
        "soft":  "#dde9f4",
        "soft-dark": "#18283a",
        "use":   "정보. 토요일/주말 강조. 액션 안내."
      }
    }
  },

  "typography": {
    "$family": "Pretendard, ui-sans-serif, system-ui, sans-serif",
    "$rule": "모든 숫자는 font-variant-numeric: tabular-nums; 강제. 한글은 letter-spacing -0.01em 권장.",
    "scale": {
      "metric-hero":  { "size": "30px", "weight": 700, "tracking": "-0.02em", "use": "어제 매출 / 합계 등 가장 큰 숫자" },
      "metric-lg":    { "size": "24px", "weight": 700, "tracking": "-0.02em", "use": "통계 카드 메인 숫자" },
      "metric-md":    { "size": "16px", "weight": 700, "use": "월 누적 / 상세 메트릭" },
      "title-lg":     { "size": "22px", "weight": 700, "tracking": "-0.01em", "use": "페이지 타이틀" },
      "title-md":     { "size": "18px", "weight": 700, "use": "섹션 타이틀" },
      "body":         { "size": "13.5px", "weight": 600, "use": "본문 강조 / 메뉴명" },
      "body-regular": { "size": "13px",   "weight": 500, "use": "일반 본문" },
      "label":        { "size": "12px",   "weight": 600, "use": "섹션 라벨 / 폼 라벨" },
      "caption":      { "size": "11.5px", "weight": 500, "use": "메타 / 보조 설명" },
      "micro":        { "size": "10.5px", "weight": 600, "use": "배지 / 단위 / 도트 라벨" }
    }
  },

  "spacing": {
    "$rule": "4px 기준. 8/12/14/16/20/28 권장.",
    "tile-padding":   "14px",
    "card-padding":   "14px",
    "screen-padding": "16px",
    "section-gap":    "20px",
    "stack-tight":    "8px",
    "stack":          "12px",
    "stack-loose":    "20px"
  },

  "radius": {
    "$rule": "둥근 모서리 일관성. 인풋 < 카드 < 큰 카드 순.",
    "sm":   "6px",
    "md":   "10px",
    "lg":   "12px",
    "xl":   "16px",
    "full": "9999px"
  },

  "stroke": {
    "$rule": "그림자 대신 보더로만 위계 표현.",
    "hairline": "1px solid var(--border)",
    "strong":   "1px solid var(--border-strong)",
    "dashed":   "1px dashed var(--border-strong)"
  },

  "interaction": {
    "tap-min": "44px",
    "transition": "all 150ms ease-out",
    "$desc": "모바일 hit target 최소 44px. 키보드 등장 시 입력 필드가 가려지지 않도록 sticky 합계 카드는 bottom: env(safe-area-inset-bottom) 사용."
  }
}
